# Copy to .env and fill in. Never commit .env.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Channel3 (trychannel3.com/developers). Optional for the spike: without it the
# spike falls back to Channel3's keyless MCP free tier.
CHANNEL3_API_KEY=

# AI provider, via any OpenAI-compatible endpoint (free tiers).
# Google Gemini (fallback), key from aistudio.google.com > Get API key
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Pick a Flash model your AI Studio project lists; 3.5 was the most reliable on 2026-10-28.
GEMINI_MODEL=gemini-3.5-flash

# Groq (primary), key from console.groq.com > API Keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Which provider the app tries first: groq or gemini
LLM_PRIMARY=groq

# Enables /api/dev/refund for the vertical slice (local only)
MATCHBACK_DEV_ROUTES=0

# Vision model for screenshot claims (Groq), Gemini is the fallback
GROQ_VISION_MODEL=qwen/qwen3.8-27b
