# Copy to .env and fill in. Never commit .env.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Channel3 (trychannel3.com/developers). Optional for the spike: without it the
# spike falls back to Channel3's keyless MCP free tier.
CHANNEL3_API_KEY=

# AI provider, via any OpenAI-compatible endpoint (free tiers).
# Google Gemini (fallback), key from aistudio.google.com > Get API key
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Pick a Flash model your AI Studio project lists; 3.5 was the most reliable on 2026-10-28.
GEMINI_MODEL=gemini-3.5-flash

# Groq (primary), key from console.groq.com > API Keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Which provider the app tries first: groq or gemini
LLM_PRIMARY=groq

# Enables /api/dev/refund for the vertical slice (local only)
MATCHBACK_DEV_ROUTES=0
# Price watch: "suggest" shows verified price drops to the shopper; "auto" files and refunds them.
MATCHBACK_WATCH_MODE=suggest
# Minutes between background price-watch passes (0 = only the "Check prices now" button).
MATCHBACK_WATCH_INTERVAL_MIN=0

# Vision model for screenshot claims (Groq), Gemini is the fallback
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Hosted database (Vercel): Supabase transaction-pooler URI, port 6543. Empty = local SQLite (data/matchback.db).
DATABASE_URL=
# Public address of the deployment, used for PayPal return URLs (optional on Vercel).
APP_BASE_URL=
# Judge mode: /judges guide page and one-click sample links on the order page.
MATCHBACK_JUDGE_MODE=0
# Secret Vercel sends to the daily price-watch cron (Authorization: Bearer ...).
CRON_SECRET=
# Merchant key for the store desk (/merchant) and the merchant console data feeds (Bearer token). Empty = off.
MERCHANT_KEY=
# AG Studio licence key (merchant console). Empty = watermark.
AG_STUDIO_LICENSE=

# Merchant settings: the defaults, until the store owner changes them on /merchant/settings.
# Claims accepted this many days after payment.
MATCHBACK_WINDOW_DAYS=14
# Ignore price differences smaller than this.
MATCHBACK_MIN_DIFF_CENTS=100
# A competitor price under this share of the price paid goes to a person.
MATCHBACK_PRICE_FLOOR_SHARE=0.6
# Largest share of the price paid one refund may return.
MATCHBACK_MAX_REFUND_SHARE=0.5
# Extra stores to honour, comma-separated domains (added to the built-in list).
MATCHBACK_EXTRA_RETAILERS=
